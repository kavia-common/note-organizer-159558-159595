# Frontend environment configuration for Notes Organizer (Vite)
# Copy this file to ".env" and adjust values for your environment.

# Base URL for the backend REST API (notes_database), e.g. "https://api.example.com"
# If omitted, the app will fall back to localStorage for demo/offline usage.
VITE_API_BASE_URL=

# Optional display name for the app
VITE_APP_NAME=Notes Organizer
